{
  "name": "dsh-rss",
  "version": "0.12.3",
  "description": "DeepSeek Harness RSS / Atom 订阅工作台：默认编辑部画报桌面（12 栏非对称封面排布 + 原生 View Transitions 原地展开居中阅读单，支持一键切回经典列表）、分类推荐先预览后订阅、多源检索与 OPML 预览导入导出，内置 13 套明亮风格与 8 套字体搭配。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "rss",
    "atom",
    "feed",
    "deepseek",
    "ai-agent",
    "opml",
    "news-aggregator",
    "RSS订阅"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "fast-xml-parser": "^5.0.0",
    "schemastery": "^3.18.0",
    "undici": "^8.12.1",
    "yaml": "^2.9.0",
    "@stardustlc/dsh-updates": "0.2.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-rss.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-rss/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-rss#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
